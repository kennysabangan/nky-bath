---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, city, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides bathtub, shower, tile, and countertop refinishing in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} refinishes bathtubs, showers, tile, and countertops in Florence, Covington, Fort Thomas, Newport, and across Northern Kentucky. How it works, what we refinish, and where we go.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Bathtub, shower, tile, and countertop refinishing for Northern Kentucky homes.</p>
    <PhoneCTA />
  </div>
</section>

<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt="Bathroom refinishing crew"
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>We refinish the bathroom surfaces people usually assume have to be torn out: bathtubs, shower stalls, tile surrounds, and countertops. Refinishing typically costs 75-90% less than replacement, takes hours instead of weeks, and can last 10-15 years with proper care.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Quote.</strong> Call {phone} or send the form. Tell us what needs refinishing — tub, shower, tile, or countertop — the material if you know it, and any chips, cracks, or stains. Most quotes are given over the phone.</p>

  <p><strong>2. Refinishing.</strong> The surface is cleaned, chips are repaired, and low-VOC, commercial-grade coatings are applied with proper ventilation. Most bathtubs take 3-5 hours; showers and tile take 4-6 hours.</p>

  <p><strong>3. Cure.</strong> The finish is ready to use in 24-48 hours. Before the crew leaves, look the work over with them.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas are {cities.map((c) => c.name.replace(/, KY$/, '')).join(', ')}:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/bath/${c.slug}/`}>Bathroom refinishing in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask — nearby towns are often fine.</p>
</div>

<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Update Your Bathroom?</p>
    <p class="cta-sub">Call now for a free {serviceKeyword} estimate.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
